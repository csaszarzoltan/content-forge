# ContentForge Environment Variables
# Copy this file to .env and fill in values.

# === Required ===

# PostgreSQL connection string (auto-set by Railway Postgres addon)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/contentforge

# OpenAI API key for content generation
LLM_API_KEY=sk-your-api-key-here

# Application secret for signing/session
SECRET_KEY=change-me-to-a-random-32-char-string

# === JWT Authentication ===

# Secret key for JWT signing (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET=change-me-in-production

# JWT signing algorithm (default: HS256)
# JWT_ALGORITHM=HS256

# Access token lifetime in minutes (default: 15)
# ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days (default: 30)
# REFRESH_TOKEN_EXPIRE_DAYS=30

# === Optional ===

# LLM model to use (default: gpt-4o)
# LLM_MODEL=gpt-4o

# LLM provider name (default: openai)
# LLM_PROVIDER=openai

# Custom LLM API base URL (for proxies)
# LLM_BASE_URL=https://api.openai.com/v1

# Deployment environment (default: development)
# ENVIRONMENT=production

# CORS origins, comma-separated (default: *)
# CORS_ORIGINS=*

# Enable LLM connectivity check in health endpoint (default: false)
# HEALTH_CHECK_LLM=false

# Brand kit asset storage root (fonts, logos). Relative to the app CWD.
# UPLOAD_ROOT=uploads

# === AI Visibility Metrics ===

# Start the AI visibility background polling loop on startup (default: false).
# The on-demand refresh endpoint POST /api/v1/ai-visibility/{content_id}/refresh
# works regardless of this flag.
# AI_VISIBILITY_POLL_ENABLED=false

# Seconds between background poll cycles (default: 86400 = once per day)
# AI_VISIBILITY_POLL_INTERVAL_SECONDS=86400

# Probe queries each engine receives per content piece per poll (default: 5)
# AI_VISIBILITY_POLL_QUERIES_PER_CONTENT=5

# Public origin of your content, e.g. https://contentforge.example — the poller
# builds the canonical target URL as <base>/generations/{id} for citation
# detection. Falls back to a reserved .example placeholder when empty.
# AI_VISIBILITY_CONTENT_BASE_URL=

# AI engine provider keys (empty => provider degrades gracefully)
# PERPLEXITY_API_KEY=
# GEMINI_API_KEY=
# CHATGPT_SEARCH_API_KEY=
# GOOGLE_AI_SEARCH_API_KEY=
